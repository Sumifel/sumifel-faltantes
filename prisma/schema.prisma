datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Motivo {
  SIN_EXISTENCIAS
  NUEVO
  URGENTE
  ALTA_DEMANDA
}

enum Estatus {
  PENDIENTE
  EN_PEDIDO
  RECIBIDO
  DESCARTADO
  DESCONTINUADO
}

model Usuario {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  rol       String     @default("EMPLEADO")
  pin       String?    // <-- Nuevo campo para el PIN secreto
  faltantes Faltante[]
}
model Faltante {
  id                Int      @id @default(autoincrement())
  producto          String
  codigoSae         String?
  codigoProv        String?
  marca             String?
  proveedorSugerido String?
  cantidadSugerida  Float
  motivo            Motivo   @default(ALTA_DEMANDA)
  diferenciaSae     Boolean  @default(false)
  estatus           Estatus  @default(PENDIENTE)
  fechaReporte      DateTime @default(now())
  reportadoPorId    Int
  reportadoPor      Usuario  @relation(fields: [reportadoPorId], references: [id])
}